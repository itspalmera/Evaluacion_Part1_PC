"""Data models for ProductType and Product using SQLModel and Pydantic validation."""

from datetime import datetime
from typing import Optional

from pydantic import field_validator
from sqlmodel import Field, Relationship, SQLModel


class ProductTypeBase(SQLModel):
    """Base schema for ProductType with validation.

    Attributes:
        name: Name of the category/subcategory (e.g. Laptops). Must be non-empty.
    """

    name: str = Field(unique=True, index=True)

    @field_validator("name")
    @classmethod
    def validate_name_not_empty(cls, value: str) -> str:
        """Validates that the category name is not empty or whitespace.

        Args:
            value (str): The product type name.

        Returns:
            str: Cleaned product type name.

        Raises:
            ValueError: If name is empty or only whitespace.
        """
        cleaned = value.strip()
        if not cleaned:
            raise ValueError("ProductType name cannot be empty.")
        return cleaned


class ProductType(ProductTypeBase, table=True):
    """ProductType database model.

    Attributes:
        id: Primary key for the product type.
        products: List of products belonging to this type (relationship).
    """

    id: Optional[int] = Field(default=None, primary_key=True)
    products: list["Product"] = Relationship(back_populates="type")


class ProductBase(SQLModel):
    """Base schema for Product with Pydantic field validations.

    Attributes:
        product_id: ID extracted from URL (/product/{id}). Must be >= 1.
        title: Title of the product. Must be non-empty.
        price_usd: Cleaned numerical price in USD. Must be >= 0.0.
        scraped_at: Timestamp of scraping execution.
        type_id: Foreign key referencing ProductType.id.
    """

    product_id: int = Field(ge=1, index=True)
    title: str
    price_usd: float = Field(ge=0.0)
    scraped_at: datetime = Field(default_factory=datetime.utcnow)
    type_id: int = Field(foreign_key="producttype.id")

    @field_validator("title")
    @classmethod
    def validate_title_not_empty(cls, value: str) -> str:
        """Validates that product title is non-empty.

        Args:
            value (str): Product title string.

        Returns:
            str: Cleaned product title.

        Raises:
            ValueError: If title is empty.
        """
        cleaned = value.strip()
        if not cleaned:
            raise ValueError("Product title cannot be empty.")
        return cleaned


class Product(ProductBase, table=True):
    """Product database model.

    Attributes:
        id: Primary key for the product record.
        type: Related ProductType object.
    """

    id: Optional[int] = Field(default=None, primary_key=True)
    type: Optional[ProductType] = Relationship(back_populates="products")